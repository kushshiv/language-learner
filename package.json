{
  "name": "language-learner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "cd apps/backend && uvicorn app.main:app --reload --port 8000",
    "dev:full": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix apps/frontend run build",
    "preview": "npm --prefix apps/frontend run preview",
    "type-check": "npm --prefix apps/frontend run type-check",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:backend": "cd apps/backend && .venv/bin/python -m pytest tests -q"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
